{
  "name": "eharness",
  "version": "0.8.0",
  "description": "Build your own agent harness on AI SDK v7: plugins, context, messages, streaming, sessions, compaction.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viandwi24/eharness.git"
  },
  "homepage": "https://github.com/viandwi24/eharness#readme",
  "bugs": "https://github.com/viandwi24/eharness/issues",
  "keywords": [
    "ai",
    "ai-sdk",
    "agent",
    "harness",
    "llm",
    "tools",
    "skills",
    "mcp"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "files": [
    "dist"
  ],
  "workspaces": [
    ".",
    "examples/coder",
    "examples/team",
    "examples/team/server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check . && bun scripts/check-throws.ts",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples && tsc --noEmit -p examples/coder && tsc --noEmit -p examples/team/server && bun run --cwd examples/team/web check",
    "test": "bun test",
    "build": "tsdown",
    "check:package": "bun scripts/check-client-bundle.ts && bun scripts/exports-snapshot.ts --dist && publint && bun pm pack --quiet --filename eharness-attw.tgz && attw eharness-attw.tgz --profile esm-only && rm eharness-attw.tgz",
    "check:imports": "bun scripts/check-imports.ts && bun scripts/check-cycles.ts",
    "check:throws": "bun scripts/check-throws.ts",
    "check:exports": "bun scripts/exports-snapshot.ts",
    "release:version": "changeset version && bun scripts/sync-version.ts && bun install --lockfile-only"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.73",
    "ai": "^7.0.137",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.73",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.2",
    "ai": "^7.0.137",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./activity": "./dist/activity/index.js",
    "./ask": "./dist/ask/index.js",
    "./client": "./dist/client/index.js",
    "./client/react": "./dist/client/react.js",
    "./connectors": "./dist/connectors/index.js",
    "./filesystem": "./dist/filesystem/index.js",
    "./filesystem/memory": "./dist/filesystem/memory.js",
    "./filesystem/node": "./dist/filesystem/node.js",
    "./group": "./dist/group/index.js",
    "./guard": "./dist/guard/index.js",
    "./http": "./dist/http/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./memory": "./dist/memory/index.js",
    "./openapi": "./dist/openapi/index.js",
    "./permissions": "./dist/permissions/index.js",
    "./providers": "./dist/providers/index.js",
    "./shell": "./dist/shell/index.js",
    "./storage/memory": "./dist/storage/memory.js",
    "./subagent": "./dist/subagent/index.js",
    "./testing": "./dist/testing/index.js",
    "./todos": "./dist/todos/index.js",
    "./web": "./dist/web/index.js",
    "./web/node": "./dist/web/node.js",
    "./package.json": "./package.json"
  }
}
