{
	"name": "eharness-team-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:api": "bun --preload ./scripts/ts5-preload.ts ../../../node_modules/openapi-typescript/bin/cli.js ../shared/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"ai": "^7.0.127",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
		"openapi-typescript": "^7.13.0",
		"paneforge": "^1.0.0-next.6",
		"phosphor-svelte": "^3.1.1",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"svelte-streamdown": "^4.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@ai-sdk/svelte": "^5.0.137",
		"@edmi-ui/tokens": "^0.5.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"media-chrome": "^4.19.3"
	}
