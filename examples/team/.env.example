# examples/team — copy to `.env` in this folder (examples/team/.env) and fill in.
# Both the server (`bun run dev` in server/) and the web (`bun run dev` in web/) read this file.
# `.env` is git-ignored; never commit real keys.

# ─── Model provider (one of them) ─────────────────────────────────────────────
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# or the Vercel AI Gateway
# AI_GATEWAY_API_KEY=

# Provider keys can also be added in the web (Settings > Providers); those are stored encrypted with
# this key: 32 bytes, base64 (openssl rand -base64 32). Unset in dev = a key file is generated into
# server/data/secret.key (git-ignored) with a warning. Set it outside development; never commit it.
# TEAM_SECRET_KEY=
# After rotating, keep the old key(s) here (comma separated) so existing profiles still open
# TEAM_SECRET_KEY_PREVIOUS=

# Optional: force the default provider (openrouter | gateway; the env profile) and a model id (openrouter | gateway) and a model id
# TEAM_PROVIDER=openrouter
# Default model of every agent (OpenRouter ids, e.g. deepseek/deepseek-v4.1-flash,
# deepseek/deepseek-v4-pro-0813, anthropic/claude-sonnet-5.5). Agents and Settings can override it.
TEAM_MODEL=deepseek/deepseek-v4.1-flash
# Optional: small/cheap model that decides actions in Auto permission mode (default: TEAM_MODEL).
# Auto mode is not offered with a scripted model.
# TEAM_CLASSIFIER_MODEL=   (a model id on the default profile, or profile:model)
# Optional: model used for web_search (OpenRouter web plugin / gateway search tool)
# TEAM_SEARCH_MODEL=
# Optional: OpenRouter base URL (proxies)
# OPENROUTER_BASE_URL=
# Optional: 1 = never fetch the public model catalogs (prices, context windows)
# TEAM_OFFLINE=

# Offline runs without any key: path to a JSON array of scripted steps (wins over the keys)
# TEAM_SCRIPTED_MODEL=./steps.json

# ─── Server ───────────────────────────────────────────────────────────────────
# Bearer token for every route except /health, /docs and /openapi.json.
# Leave empty only on localhost (loopback bind): an empty token means the API is open, guarded only
# by the Host allow-list and the Origin check. On any other bind (TEAM_HOST) the server refuses
# to start with a token shorter than 16 characters or starting with "dev-".
# Generate one: openssl rand -base64 32
TEAM_TOKEN=
# HTTP port of the server
PORT=4000
# SQLite file (WAL). Several server instances may share it. Relative to server/.
TEAM_DB=./data/team.db
# Monthly USD limit of the workspace ledger (also editable in Settings); empty = no limit
TEAM_BUDGET_USD=
# Role agents the lead runs at once (also editable in Settings)
TEAM_SPAWN_CAP=4
# Routine ticker interval in ms (0 = routines off)
TEAM_ROUTINE_TICK_MS=15000
# Events feed retention: hours kept (0 = by count only) and max rows; pruned at boot and every 10 min.
# TEAM_EVENTS_RETENTION_HOURS=72
# TEAM_EVENTS_MAX_ROWS=100000

# ─── Web (SvelteKit dev server) ───────────────────────────────────────────────
# Where `/api` is proxied in dev (must match PORT above)
TEAM_API_PROXY=http://localhost:4000
# Token the browser sends (must equal TEAM_TOKEN). It is INLINED into the web bundle: anyone who can
# load the built web can read it. Dev only; otherwise leave empty and paste the token on the web's
# Settings page. Generate: openssl rand -base64 32
PUBLIC_TEAM_TOKEN=
# API base URL for a deployed web (dev uses the /api proxy)
# PUBLIC_API_URL=
