# examples/team — copy to `.env` in this folder (examples/team/.env) and fill in.
# The same file serves both ways of running the example:
#   - development: `bun run dev` here (server + web dev server read this file)
#   - Docker:      `docker run --env-file examples/team/.env ...` (see the Docker section below)
# `.env` is git-ignored; never commit real keys.

# ─── Model provider (one of them) ─────────────────────────────────────────────
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# or the Vercel AI Gateway
# AI_GATEWAY_API_KEY=

# Optional: force the default provider (openrouter | gateway; the env profile)
# TEAM_PROVIDER=openrouter
# Default model of every agent (OpenRouter ids, e.g. deepseek/deepseek-v4.1-flash,
# deepseek/deepseek-v4-pro-0813, anthropic/claude-sonnet-5.5). Agents and Settings can override it.
TEAM_MODEL=deepseek/deepseek-v4.1-flash
# Optional: small/cheap model that decides actions in Auto permission mode (default: TEAM_MODEL).
# Auto mode is not offered with a scripted model.
# TEAM_CLASSIFIER_MODEL=   (a model id on the default profile, or profile:model)
# Optional: model used for web_search (OpenRouter web plugin / gateway search tool)
# TEAM_SEARCH_MODEL=
# Optional: OpenRouter base URL (proxies)
# OPENROUTER_BASE_URL=
# Optional: 1 = never fetch the public model catalogs (prices, context windows, input modalities)
# TEAM_OFFLINE=

# Offline runs without any key: path to a JSON array of scripted steps (wins over the keys)
# TEAM_SCRIPTED_MODEL=./steps.json

# ─── Secrets at rest ──────────────────────────────────────────────────────────
# 32 bytes, base64 each (openssl rand -base64 32). Unset = a key file is generated next to the
# database (data/secret.key, data/channel.key; /data in Docker) with a warning. Set both outside
# development, keep them out of the database backup, never commit them.
# Provider keys added in Settings > Providers, connection secrets and tokens:
# TEAM_SECRET_KEY=
# After rotating, keep the old key(s) here (comma separated) so existing secrets still open
# TEAM_SECRET_KEY_PREVIOUS=
# The channel message log (chat platforms), its own key:
# TEAM_CHANNEL_KEY=
# TEAM_CHANNEL_KEY_PREVIOUS=

# ─── Server ───────────────────────────────────────────────────────────────────
# Bearer token for every route except /health, /docs and /openapi.json.
# Empty is allowed only on a loopback bind (development): the API is then open, guarded only by the
# Host allow-list and the Origin check. On any other bind (TEAM_HOST, always in Docker) the server
# refuses to start with a token shorter than 16 characters or starting with "dev-".
# Generate one: openssl rand -base64 32
TEAM_TOKEN=
# Password login for the web (optional). Set it and every route needs a signed-in browser (a
# `team_session` cookie, 30 days) or the Bearer TEAM_TOKEN (scripts, API clients). Unset = no login.
# Use a LONG password (a non-loopback bind without TEAM_TOKEN requires 12+ characters:
# openssl rand -base64 18) and serve over HTTPS anywhere outside localhost: the password is sent in
# clear text over plain HTTP. Changing it signs everyone out. Failed logins are throttled per client.
# Behind a reverse proxy also set TEAM_TRUST_PROXY=1 (per-client throttle, Secure cookie).
BASIC_AUTH_PASSWORD=
# HTTP port of the server
PORT=4000
# Bind address (default 127.0.0.1; the Docker image sets 0.0.0.0)
# TEAM_HOST=
# SQLite file (WAL); several server instances may share it. Default ./data/team.db (relative to
# server/); the Docker image uses /data/team.db. Leave unset unless you need another file.
# TEAM_DB=
# Where the browser reaches the API (OAuth callback `<url>/oauth/callback`) and the web app
# (OAuth redirects to `<url>/connectors`). Dev defaults: http://localhost:4000 and
# http://localhost:5173. Docker defaults: http://localhost:4000/api and http://localhost:4000.
# Set both when the app is reached under another host name or port.
# TEAM_PUBLIC_URL=
# TEAM_WEB_URL=
# Extra Host header names to accept (comma separated; loopback, TEAM_HOST and the host of
# TEAM_PUBLIC_URL always are) and extra browser origins allowed to send state-changing requests
# TEAM_ALLOWED_HOSTS=
# TEAM_ALLOWED_ORIGINS=
# Default of the team timezone (Settings → Team timezone): the one clock of the app, agents ("now",
# the datetime tool), routines, reminders, chat times, digest and active hours. Else the host
# timezone (UTC in Docker). The Settings value wins once saved.
# TZ=Asia/Jakarta
# Monthly USD limit of the workspace ledger (also editable in Settings); empty = no limit
TEAM_BUDGET_USD=
# Role agents the lead runs at once (also editable in Settings)
TEAM_SPAWN_CAP=4
# Hard cap of one background worker turn (long jobs such as auditing a chat); default 400, at least 60
# Background worker jobs run in chunks (no fixed step cap): stop at this estimated cost (USD) or age (hours); 0 = no limit
# TEAM_LONG_RUN_MAX_COST_USD=10
# TEAM_LONG_RUN_MAX_HOURS=24
# DEPRECATED global ceiling on every agent's context window, in tokens. Unset by default: the window
# follows each agent's model, and an agent can set its own smaller limit and summarize-at percent in its settings.
# TEAM_CONTEXT_CAP=128000
# Code sandbox (run_python of the Files & Sandbox connector, README "Code sandbox"):
# off | local. Default: local when the interpreter is found, else off.
# TEAM_CODE_DRIVER=local
# TEAM_CODE_PYTHON=python3
# off | allowlist | any: agents may add Python packages (local driver only; asks first)
# TEAM_CODE_INSTALL=off
# TEAM_CODE_ALLOW=pandas,numpy==2.5.4
# TEAM_CODE_ENV_ROOT=./data/python-envs
# TEAM_CODE_REQUIREMENTS=./python/requirements.txt
# Browser (the Browser connector and the /browser page, docs/plans/P48-browser.md):
# off | local. Default: local when the root is writable, else off (profiles then connect to an existing browser).
# TEAM_BROWSER_DRIVER=local
# Downloaded engines and the logins of managed profiles (safe to delete: profiles stay, logins are lost).
# TEAM_BROWSER_ROOT=./data/browser
# 1 = headed Chrome on a Linux server without a display (xvfb-run).
# TEAM_BROWSER_XVFB=1
# Browsers open at once (the Browser page shows memory and CPU of each).
# TEAM_BROWSER_MAX=4
# Routine ticker interval in ms (0 = routines off)
TEAM_ROUTINE_TICK_MS=15000
# Events feed retention: hours kept (0 = by count only) and max rows; pruned at boot and every 10 min.
# TEAM_EVENTS_RETENTION_HOURS=72
# TEAM_EVENTS_MAX_ROWS=100000
# A new workspace starts empty (no agents). 1 = add the example agents (Lead, Researcher, Writer,
# Analyst, Ops) the first time the database is created.
# TEAM_SEED_AGENTS=1
# 1 = register the demo community source (5 000 deterministic chat messages) for the big-data tools
# TEAM_DEMO_COLLECTOR=

# ─── Web (SvelteKit dev server; ignored by Docker) ────────────────────────────
# Where `/api` is proxied in dev (must match PORT above)
TEAM_API_PROXY=http://localhost:4000
# Token the browser sends (must equal TEAM_TOKEN). It is INLINED into the web bundle at build time:
# anyone who can load the built web can read it. Dev only; otherwise leave empty and paste the token
# on the web's Settings page (the Docker image never inlines it).
PUBLIC_TEAM_TOKEN=
# API base URL for a web deployed apart from the server (dev uses the /api proxy)
# PUBLIC_API_URL=

# ─── Docker ───────────────────────────────────────────────────────────────────
# One image, one port: the server serves the built web at `/` and the API under `/api`
# (TEAM_WEB_DIR, set by the image). From the repository root:
#
#   docker build -f examples/team/Dockerfile -t eharness-team .
#   docker run -d --name team -p 4000:4000 --env-file examples/team/.env -v team-data:/data eharness-team
#
# Required: TEAM_TOKEN (16+ characters) and a model key. Recommended: TEAM_SECRET_KEY,
# TEAM_CHANNEL_KEY, TZ. Open http://localhost:4000 and paste TEAM_TOKEN on the Settings page.
# Publishing another host port or a domain (e.g. -p 8080:4000)? Set TEAM_PUBLIC_URL=http://localhost:8080/api;
# the web URL (links in agent replies, artifacts, shares) follows it without /api.

# Optional: the team's name, given to the agent in chat sessions ("You are <agent>, the assistant of <team>").
# TEAM_NAME=
